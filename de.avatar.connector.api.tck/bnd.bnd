-library: \
	enable-emf

# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-buildpath: \
	org.osgi.framework;version=latest,\
	de.avatar.connector.api;version=project,\
	de.avatar.connector.model;version=project
	
-workingset: connector
	
Bundle-Version: 1.0.0.SNAPSHOT

-buildpath.junit5: ${test-path}

test-path: \
	${junit},\
	${mockito},\
	${osgitest}
	
-require-bnd: "(version>=7.0.0)"

