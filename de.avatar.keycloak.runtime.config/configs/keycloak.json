{
   ":configurator:resource-version": 1,
   "KeycloakService~forwardQuery": {
   		"service.name": "QueryForwardService",
   		"service.type": "prod",
   		"configuration.file.path": "$[env:FORWARD_QUERY_SECRETS;default=$[prop:FORWARD_QUERY_SECRETS;default=/opt/avatar/secrets/config-query-forwarding-service.json]]"
   },
   "KeycloakService~statusUpdate": {
   		"service.name": "StatusUpdateService",
   		"service.type": "prod",
   		"configuration.file.path": "$[env:STATUS_UPDATE_SECRETS;default=$[prop:STATUS_UPDATE_SECRETS;default=/opt/avatar/secrets/config-query-status-service.json]]"
   }
}