-buildpath: \
	de.avatar.connectors.demo;version=project,\
	org.osgi.service.condition;version='1.0',\
	org.osgi.service.cm;version=latest,\
	org.osgi.service.log;version=latest,\
	org.osgi.framework;version=latest,\
	org.osgi.annotation.versioning;version=latest,\
	org.osgi.annotation.bundle;version=latest,\
	org.osgi.service.component.annotations;version=latest

Bundle-Name: Playground Workmode 
Bundle-Description: Gecko Playground Workmode
-privatepackage: \
	de.avatar.connectors.demo.workmode.command,\
	de.avatar.connectors.demo.workmode.internal
Export-Package: \
	de.avatar.connectors.demo.workmode,\
	de.avatar.connectors.demo.workmode.annotations
	