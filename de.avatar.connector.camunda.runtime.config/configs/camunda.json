{
  ":configurator:resource-version": 1,
  
  "OrchestratorWorker~termination":
	{
		"camunda.worker.name": "manual-termination",
		"camunda.worker.type": "prod",
		"keycloakService.target": "(service.name=StatusUpdateService)",
		"camunda.engine.url": "http://apisix-gateway:9080/api/camundainterface/engine-rest",
		"camunda.polling.timeout": 10000,
		"camunda.task.topic": "manual-termination",
		"camunda.task.lock.duration": 1000,
		"worker.task.handler.type": "QUERY_INTERRUPT_REQUEST"
	},
	"OrchestratorWorker~link":
	{
		"camunda.worker.name": "link-request",
		"camunda.worker.type": "prod",
		"keycloakService.target": "(service.name=StatusUpdateService)",
		"camunda.engine.url": "http://apisix-gateway:9080/api/camundainterface/engine-rest",
		"camunda.polling.timeout": 10000,
		"camunda.task.topic": "link-request",
		"camunda.task.lock.duration": 1000,
		"worker.task.handler.type": "PUBLIC_LINK_REQUEST"
	},
	"OrchestratorWorker~status":
	{
		"camunda.worker.name": "update-status",
		"camunda.worker.type": "prod",
		"keycloakService.target": "(service.name=StatusUpdateService)",
		"camunda.engine.url": "http://apisix-gateway:9080/api/camundainterface/engine-rest",
		"camunda.polling.timeout": 10000,
		"camunda.task.topic": "update-status",
		"camunda.task.lock.duration": 1000,
		"worker.task.handler.type": "STATUS_UPDATE"
	},
	"CamundaProcessLauncher~query":
	{
		"camunda.process.name": "forward-query",
		"camunda.process.type": "prod",
		"keycloakService.target": "(service.name=StatusUpdateService)",
		"camunda.process.url": "http://apisix-gateway:9080/api/processuserinterface/api/service/start?uuid=a1fe70d7-8f4c-4eda-86d7-6cce47096c6e"
	},
	"OrchestratorTaskCacheService~termination": {
		"task.status.type": "QUERY_INTERRUPT_REQUEST",
		"task.status.msg": "The query has been interrupted by the user"
	},
	"OrchestratorTaskCacheService~publiclink": {
		"task.status.type": "PUBLIC_LINK_REQUEST",
		"task.status.msg": "The user has responded to a public link request"
	},
	"OrchestratorTaskCacheService~cancel": {
		"task.status.type": "CANCEL_REQUEST",
		"task.status.msg": "The process has been canceld. Any previously produced data will be removed."
	}
}