-library: enable-emf

Bundle-Version: 1.0.0.SNAPSHOT
-buildpath: \
	org.camunda.bpm.external.task.client,\
	de.avatar.keycloak.service.api;version=snapshot,\
	org.keycloak.client.common.synced,\
	org.apache.httpcomponents.core5,\
	org.apache.httpcomponents.client5,\
	com.fasterxml.jackson.core.jackson-databind,\
	com.fasterxml.jackson.core.jackson-core,\
	de.avatar.connector.camunda.api;version=snapshot,\
	de.avatar.connector.whiteboard,\
	org.osgi.service.component,\
	de.avatar.connector.api;version=snapshot,\
	de.avatar.query.status.model,\
	de.avatar.query.model;version=snapshot,\
	org.gecko.emf.util.model,\
	de.avatar.connector.model,\
	de.avatar.metadata.model;version=snapshot
	
-includeresource: OSGI-INF/configurator/=configs/
Require-Capability: \
	osgi.extender;filter:='(osgi.extender=osgi.configurator)',\
	osgi.implementation;filter:='(&(osgi.implementation=osgi.cm)(version>=1.6.0)(!(version>=2.0.0)))'
