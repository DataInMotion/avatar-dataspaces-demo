-runfw: org.apache.felix.framework;version='[7.0.1,7.0.1]'
-runprovidedcapabilities: ${native_capability}

-resolve.effective: active;skip:=osgi.service

-runproperties: \
	org.osgi.service.http.port=8080,\
	osgi.console=,\
	osgi.console.enable.builtin=false,\
	secrets/=./secrets/
	
-runvm: -Dorg.slf4j.simpleLogger.defaultLogLevel=info

-runbundles: \
	de.avatar.connector.emf;version=snapshot,\
	bctls;version='[1.70.0,1.70.1)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	com.paremus.cluster.api;version='[1.0.0,1.0.1)',\
	com.paremus.discovery.cluster;version='[1.0.0,1.0.1)',\
	com.paremus.dosgi.api;version='[1.0.0,1.0.1)',\
	com.paremus.dosgi.topology.common;version='[1.0.0,1.0.1)',\
	com.paremus.dosgi.topology.simple;version='[1.0.0,1.0.1)',\
	com.paremus.gossip.netty;version='[1.0.0,1.0.1)',\
	io.netty.buffer;version='[4.1.72,4.1.73)',\
	io.netty.codec;version='[4.1.72,4.1.73)',\
	io.netty.common;version='[4.1.72,4.1.73)',\
	io.netty.handler;version='[4.1.72,4.1.73)',\
	io.netty.resolver;version='[4.1.72,4.1.73)',\
	io.netty.tcnative-classes;version='[2.0.46,2.0.47)',\
	io.netty.transport;version='[4.1.72,4.1.73)',\
	org.apache.felix.cm.json;version='[2.0.0,2.0.1)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.scr;version='[2.2.6,2.2.7)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.pushstream;version='[1.1.0,1.1.1)',\
	org.paremus.netty.tls;version='[1.0.0,1.0.1)',\
	slf4j.simple;version='[1.7.30,1.7.31)',\
	bcprov;version='[1.70.0,1.70.1)',\
	bcutil;version='[1.70.0,1.70.1)',\
	com.paremus.dosgi.net;version='[1.0.1,1.0.2)',\
	org.eclipse.emf.common;version='[2.29.0,2.29.1)',\
	org.eclipse.emf.ecore;version='[2.35.0,2.35.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.36.0,2.36.1)',\
	org.osgi.service.event;version='[1.4.1,1.4.2)',\
	de.avatar.connector.model;version=snapshot,\
	de.avatar.connector.whiteboard;version=snapshot,\
	org.gecko.emf.osgi.component.minimal;version='[6.2.0,6.2.1)',\
	org.osgi.service.cm;version='[1.6.1,1.6.2)',\
	de.avatar.connector.api;version=snapshot,\
	com.fasterxml.jackson.core.jackson-annotations;version='[2.18.3,2.18.4)',\
	com.fasterxml.jackson.core.jackson-core;version='[2.18.3,2.18.4)',\
	com.fasterxml.jackson.core.jackson-databind;version='[2.18.3,2.18.4)',\
	com.fasterxml.jackson.datatype.jackson-datatype-jdk8;version='[2.18.3,2.18.4)',\
	com.fasterxml.jackson.datatype.jackson-datatype-jsr310;version='[2.14.1,2.14.2)',\
	de.avatar.generator.api;version=snapshot,\
	de.avatar.keycloak.service.api;version=snapshot,\
	de.avatar.query.model;version=snapshot,\
	de.avatar.query.status.model;version=snapshot,\
	jakarta.activation-api;version='[2.1.2,2.1.3)',\
	jakarta.xml.bind-api;version='[4.0.0,4.0.1)',\
	org.apache.httpcomponents.client5;version='[5.4.2,5.4.3)',\
	org.apache.httpcomponents.core5;version='[5.3.3,5.3.4)',\
	org.apache.httpcomponents.core5.h2;version='[5.3.3,5.3.4)',\
