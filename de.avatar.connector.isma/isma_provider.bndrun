-runrequires: \
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.shell)',\
	osgi.identity;filter:='(osgi.identity=org.apache.felix.gogo.command)',\
	bnd.identity;id='com.paremus.dosgi.net',\
	bnd.identity;id='com.paremus.discovery.cluster',\
	bnd.identity;id='com.paremus.dosgi.topology.simple',\
	bnd.identity;id='de.avatar.connector.emf',\
	bnd.identity;id='org.eclipse.parsson.jakarta.json',\
	bnd.identity;id='de.avatar.connector.isma',\
	bnd.identity;id='org.gecko.emf.json',\
	bnd.identity;id='org.avatar.himsa.model'
	
-runee: JavaSE-17
-resolve: manual