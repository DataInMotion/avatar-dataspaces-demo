{
  ":configurator:resource-version": 1,
  
  "OrchestratorWorker~termination":
	{
		"camunda.worker.name": "manual-termination",
		"camunda.worker.type": "local",
		"keycloakService.target": "(service.name=StatusUpdateService)",
		"camunda.engine.url": "http://localhost:8080/engine-rest",
		"camunda.polling.timeout": 10000,
		"camunda.task.topic": "manual-termination",
		"camunda.task.lock.duration": 1000,
		"worker.task.handler.type": "MANUAL_TERMINATION"
	},
	"OrchestratorWorker~status":
	{
		"camunda.worker.name": "update-status",
		"camunda.worker.type": "local",
		"keycloakService.target": "(service.name=StatusUpdateService)",
		"camunda.engine.url": "http://localhost:8080/engine-rest",
		"camunda.polling.timeout": 10000,
		"camunda.task.topic": "update-status",
		"camunda.task.lock.duration": 1000,
		"worker.task.handler.type": "STATUS_UPDATE"
	},
	"CamundaProcessLauncher~query":
	{
		"camunda.process.name": "forward-query",
		"camunda.process.type": "local",
		"keycloakService.target": "(service.name=StatusUpdateService)",
		"camunda.process.url": "http://localhost:8080/engine-rest/process-definition/key/forward-query/start"
	}
}