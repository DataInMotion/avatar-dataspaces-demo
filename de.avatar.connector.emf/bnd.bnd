src=${^src},src-gen

-library: enable-emf

-includeresource.model: model=model

-generate:\
	model/rsa.genmodel;\
		generate=geckoEMF;\
		genmodel=model/rsa.genmodel;\
		output=src-gen

-buildpath: \
	org.osgi.service.component;version=latest,\
	com.paremus.dosgi.net;version=latest,\
	de.avatar.connector.model;version=snapshot,\
	io.netty.buffer