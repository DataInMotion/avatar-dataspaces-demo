-library: \
	enableJakartaREST,\
	enable-emf

buildpath:  \
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.http.whiteboard;version=latest,\
	org.gecko.emf.rest.jakartars;version=latest,\
	org.gecko.emf.json;version=latest,\
	org.gecko.emf.util.model

-includeresource: \
	data/=data/

Bundle-Version: 1.0.0.SNAPSHOT
Private-Package: de.avatar.query.rest
-buildpath: \
	de.avatar.connector.model;version=snapshot,\
	de.avatar.query.status.model;version=snapshot,\
	de.avatar.generator.api;version=snapshot,\
	org.gecko.emf.util.annotations,\
	org.gecko.emf.util.model,\
	de.avatar.query.backend,\
	de.avatar.query.model,\
	org.eclipse.osgitech.rest
