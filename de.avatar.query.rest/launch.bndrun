-include: ~base.bndrun

#Avoid To have the default Jetty run at port 8080	
-runproperties: \
	org.osgi.service.http.port=-1,\
	org.eclipse.emf.common.util.URI.archiveSchemes="wsjar wszip jar zip",\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation,\
	org.apache.felix.configadmin.plugin.interpolation.secretsdir=/opt/avatar/secrets
	

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-17
-runbundles.runtime: \
	de.avatar.keycloak.runtime.config;version=snapshot,\
	de.avatar.connector.camunda.runtime.config;version=snapshot,\
	de.avatar.connector.whiteboard.runtime.config;version=snapshot
-resolve: never