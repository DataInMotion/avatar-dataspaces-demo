-include: ~base.bndrun

#Avoid To have the default Jetty run at port 8080	
-runproperties: \
	org.osgi.service.http.port=-1,\
	data=./data/,\
	secrets/=./secrets/,\
	org.eclipse.emf.common.util.URI.archiveSchemes="wsjar wszip jar zip"
	
-runrequires: \
	bnd.identity;id='de.avatar.connector.camunda.local.config',\
	bnd.identity;id='de.avatar.keycloak.local.config'

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-17
-runbundles: \
	bcprov;version='[1.70.0,1.70.1)',\
	bctls;version='[1.70.0,1.70.1)',\
