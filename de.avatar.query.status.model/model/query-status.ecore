    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="status" nsURI="https://avatar-project.de/query/status/1.0.0"
    nsPrefix="status">
  <eAnnotations source="Version">
    <details key="value" value="1.0"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
