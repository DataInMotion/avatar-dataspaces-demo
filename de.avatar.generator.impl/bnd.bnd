-library: enable-emf
Bundle-Version: 1.0.0.SNAPSHOT
-buildpath: \
	de.avatar.generator.api;version=snapshot,\
	de.avatar.connector.model;version=snapshot,\
	com.fasterxml.jackson.core.jackson-core,\
	com.fasterxml.jackson.core.jackson-databind,\
	org.osgi.service.component
	
-includeresource: OSGI-INF/configurator/=configs/avatar-cleanup.json
Require-Capability: osgi.extender;filter:='(osgi.extender=osgi.configurator)'