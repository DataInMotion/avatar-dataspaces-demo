{
  ":configurator:resource-version": 1,
  
  "CamundaProcessLauncher~status":
	{
		"camunda.process.name": "update-status",
		"keycloakService.target": "(serviceName=StatusUpdateService)",
		"camunda.process.url": "http://localhost:8080/engine-rest/process-definition/key/update-status/start"
	},
	"CamundaProcessLauncher~query":
	{
		"camunda.process.name": "forward-query",
		"keycloakService.target": "(serviceName=QueryForwardService)",
		"camunda.process.url": "http://localhost:8080/engine-rest/process-definition/key/forward-query/start"
	}
}