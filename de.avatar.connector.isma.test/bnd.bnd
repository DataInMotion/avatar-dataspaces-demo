Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-library: \
	enableOSGi-Test,\
	enable-emf
	
-workingset: provider

-dependson: de.avatar.connector.isma

-includeresource: \
	tck/de.avatar.connector.api.tck.jar=${repo;de.avatar.connector.api.tck}
	
# sets the usually required buildpath using the bnd library, you can extend it with the normal -buildpath to your liking
-buildpath: \
	org.osgi.framework;version=latest,\
	de.avatar.connector.api.tck;version=snapshot,\
	de.avatar.connector.api;version=snapshot,\
	de.avatar.connector.model;version=snapshot,\
	de.avatar.connector.isma;version=snapshot
	
Bundle-Version: 1.0.0.SNAPSHOT
Bundle-ClassPath: tck/de.avatar.connector.api.tck.jar,.

# Sometimes without DynamicImport Mockito will not find certain classes
#DynamicImport-Package: *