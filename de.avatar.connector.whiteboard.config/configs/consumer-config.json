{
  ":configurator:resource-version": 1,
  
	"com.paremus.dosgi.discovery.cluster~DIM": 
  	{
		"root.cluster": "DIMC",
		"infra": "false"
	},
	"com.paremus.gossip.netty~DIM": 
  	{
		"initial.peers": ["CONN01:9032", "CONN02:9032", "QBACKEND:9032"],
