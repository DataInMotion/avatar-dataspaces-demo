		"tcp.port": 9032,
		"cluster.name": "DIMC"
	},
	"com.paremus.netty.tls": 
  	{
  		"insecure":true
	},
	"com.paremus.dosgi.net":
	{
		"server.bind.address": "QBACKEND",
		"allow.insecure.transports": true,
		"server.protocols": "TCP;nodelay=true",
		"nodelay": true
  	}
}